cosine_sim <- function(mat) {
n <- nrow(mat)
sim <- matrix(0, n, n)
for (i in 1:(n-1)) {
for (j in (i+1):n) {
v1 <- mat[i, ]; v2 <- mat[j, ]
num <- sum(v1 * v2)
denom <- sqrt(sum(v1^2)) * sqrt(sum(v2^2))
sim[i, j] <- sim[j, i] <- ifelse(denom == 0, 0, num / denom)
}
}
diag(sim) <- 1
return(sim)
}
