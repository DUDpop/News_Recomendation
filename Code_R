relevant_ibcf <- 0
for (rid in rec_ibcf) {
rid_char <- as.character(rid)
if (rid_char %in% colnames(user_vec)) {
if (user_vec[1, rid_char] == 1) {
relevant_ibcf <- relevant_ibcf + 1
}
}
}
prec_ibcf_vals <- c(prec_ibcf_vals, relevant_ibcf / 5)
}
}
}
