train_sizes <- c(200, 400, 600, 800, 1000, 1200, 1500)
precision_ubcf <- numeric(length(train_sizes))
precision_ibcf <- numeric(length(train_sizes))
set.seed(123)
for (idx in seq_along(train_sizes)) {
n_train <- train_sizes[idx]
if (n_train + 50 > n_users) {
precision_ubcf[idx] <- NA
precision_ibcf[idx] <- NA
next
}
train_users <- 1:n_train
train_mat <- binary_mat[train_users, ]
test_users <- (n_train + 1):min(n_train + 100, n_users)
if (length(test_users) < 20) {
precision_ubcf[idx] <- NA
precision_ibcf[idx] <- NA
next
}
test_mat <- binary_mat[test_users, ]
model_ubcf_temp <- Recommender(train_mat, method = "UBCF",
param = list(method = "jaccard", nn = 40))
model_ibcf_temp <- Recommender(train_mat, method = "IBCF",
param = list(method = "jaccard", k = 30))
prec_ubcf_vals <- c()
prec_ibcf_vals <- c()
for (i in 1:nrow(test_mat)) {
user_data <- test_mat[i, ]
user_vec <- as(user_data, "matrix")
read_indices <- which(user_vec[1, ] == 1)
if (length(read_indices) >= 10) {
known_idx <- read_indices[1:10]
known_vec <- matrix(0, nrow = 1, ncol = ncol(train_mat))
colnames(known_vec) <- colnames(train_mat)
for (j in known_idx) {
col_name <- colnames(train_mat)[j]
known_vec[1, col_name] <- 1
}
known_mat <- as(known_vec, "binaryRatingMatrix")
pred_ubcf <- predict(model_ubcf_temp, known_mat, n = 5)
rec_ubcf <- as(pred_ubcf, "list")[[1]]
if (length(rec_ubcf) > 0) {
relevant_ubcf <- 0
for (rid in rec_ubcf) {
rid_char <- as.character(rid)
if (rid_char %in% colnames(user_vec)) {
if (user_vec[1, rid_char] == 1) {
relevant_ubcf <- relevant_ubcf + 1
}
}
}
prec_ubcf_vals <- c(prec_ubcf_vals, relevant_ubcf / 5)
}
pred_ibcf <- predict(model_ibcf_temp, known_mat, n = 5)
rec_ibcf <- as(pred_ibcf, "list")[[1]]
